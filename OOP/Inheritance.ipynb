    "class Person:\n",
    "    def __init__(self, fname, lname):\n",
    "        self.fname = fname\n",
    "        self.lname = lname\n",
    "        \n",
    "    def printName(self):\n",
    "        print(f\"FUll NAME IS {self.fname} {self.lname}\")\n",
    "        \n",
    "class Student(Person):\n",
    "    pass\n",
    "\n",
    "x = Student(\"EMON\", \"RAHMAN\")\n",
    "x.printName"
   ]
